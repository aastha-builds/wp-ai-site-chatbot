# SiteSage Chat local settings. Copy to .env (never commit .env).
# bin/local-wp.sh exports these, and the plugin reads them with getenv()
# when the matching setting is empty in WP Admin.

# true = saved sample answers and offline embeddings, no API key or cost.
DEMO_MODE=true

# Chat provider: openai or anthropic.
SITESAGE_PROVIDER=openai

# Model name. Leave empty for the default (gpt-4.1-mini or claude-opus-5-5).
SITESAGE_MODEL=

# OpenAI key: used for embeddings, and for answers when the provider is openai.
OPENAI_API_KEY=

# Anthropic key: used for answers when the provider is anthropic.
ANTHROPIC_API_KEY=

# Port for the local PHP server.
WP_PORT=8080
