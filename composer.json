{
	"name": "aastha-builds/sitesage-chat",
	"description": "SiteSage Chat: a WordPress plugin that adds an AI chatbot trained on the site's own content (demo project).",
	"type": "wordpress-plugin",
	"license": "MIT",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
