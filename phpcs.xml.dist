<?xml version="1.0"?>
<ruleset name="SiteSage Chat">
	<description>WordPress Coding Standards for SiteSage Chat.</description>

	<file>sitesage-chat.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sitesage-chat"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sitesage"/>
				<element value="SiteSage"/>
			</property>
		</properties>
	</rule>
</ruleset>
